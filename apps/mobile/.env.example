# Firebase App Distribution — App IDs from Firebase Console → Project settings → Your apps
# Format: 1:PROJECT_NUMBER:android:HEX  /  1:PROJECT_NUMBER:ios:HEX
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=

# GA4 Measurement Protocol API secret (GA4 → Admin → Data Streams → Measurement Protocol API secrets)
EXPO_PUBLIC_GA4_API_SECRET=
